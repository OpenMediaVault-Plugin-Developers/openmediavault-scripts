{%- set separator = ' ' -%}
{{ pillar['headers']['multiline'] }}
SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin
# m h dom mon dow user    command
{%- for job in jobs | selectattr('enable') %}
{%- set script = salt['omv_conf.get']('conf.service.scripts.file', job.script) %}
{% if job.execution == "exactly" -%}
{% if job.everynminute | to_bool %}*/{{ job.minute }}{% else %}{{ job.minute }}{% endif -%}
{{ separator }}{% if job.everynhour | to_bool %}*/{{ job.hour }}{% else %}{{ job.hour }}{% endif -%}
{{ separator }}{% if job.everyndayofmonth | to_bool %}*/{{ job.dayofmonth }}{% else %}{{ job.dayofmonth }}{% endif -%}
{{ separator }}{{ job.month }}{{ separator }}{{ job.dayofweek }}
{%- else -%}
@{{ job.execution }}
{%- endif -%}
{%- set wrapper = "/usr/sbin/omv-scripts-exec-wrapper '" ~ sfpath ~ "/" ~ script.name ~ "." ~ script.ext ~ "' " ~ job.args -%}
{%- set subject_raw = 'Cron' ~ (' - ' ~ (job.comment | replace('\n', ' ')) if job.comment | length > 0 else '') -%}
{%- set subject = subject_raw | replace('\\', '\\\\') | replace('"', '\\"') | replace('`', '\\`') | replace('$', '\\$') -%}
{{ separator }}root{{ separator }}
{%- if job.sendemail | to_bool and job.emailonerror | to_bool -%}
out=$({{ wrapper }} 2>&1); [ $? -eq 0 ] || echo "$out" | mail -E -s "{{ subject }} (failed)" -a "From: Cron Daemon <root>" root >/dev/null 2>&1
{%- elif job.sendemail | to_bool -%}
{{ wrapper }} 2>&1 | mail -E -s "{{ subject }}" -a "From: Cron Daemon <root>" root >/dev/null 2>&1
{%- else -%}
{{ wrapper }} >/dev/null 2>&1
{%- endif -%}
{%- endfor -%}
